# ==============================================================================
# InternShield AI - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# The .env file is git-ignored and will not be committed to GitHub.

# Server Configuration
PORT=8080

# Database Configuration (Option A: Supabase PostgreSQL via connection string - Recommended on Render)
# DATABASE_URL=postgresql://postgres.voljvzvcoptqadeeymjj:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or via discrete variables for Supabase:
# DB_HOST=db.voljvzvcoptqadeeymjj.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your_supabase_db_password_here
# DB_SSL_MODE=require

# Database Configuration (Option B: Aiven / Local MySQL)
DB_HOST=mysql-1d78c945-saibhumireddy1-a717.h.aivencloud.com
DB_PORT=27926
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_mysql_password_here
DB_SSL_MODE=REQUIRED

# Supabase Authentication Configuration
SUPABASE_URL=https://voljvzvcoptqadeeymjj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI API Keys
GOOGLE_API_KEY=your_gemini_api_key_here
OCTEN_API_KEY=your_octen_api_key_here

# CORS Configuration (Render backend allowed frontend origins)
# Set this to your deployed Vercel frontend URL so the frontend can communicate with this backend.
# Multiple comma-separated domains are supported (e.g. your Vercel domain and local test ports).
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173
